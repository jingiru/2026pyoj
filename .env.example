NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# New Supabase projects may provide this instead of NEXT_PUBLIC_SUPABASE_ANON_KEY.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only teacher dashboard password. Do not prefix with NEXT_PUBLIC_.
TEACHER_PASSWORD=change-this-password

# Server-only key from Supabase Project Settings > API.
# Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
